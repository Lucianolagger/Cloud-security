# ── Local development variables (.env.example) ────────────────────────────
# Copy this file to .dev.vars for `wrangler dev` local testing.
# NEVER commit .dev.vars or any file containing real credentials.
#
# Production: set every variable below as a Wrangler secret:
#   wrangler secret put <VARIABLE_NAME>
#
# Generate secrets with:
#   openssl rand -hex 32
#
# GOV_KV is a KV namespace binding — set its id in wrangler.toml, NOT here.

# ── 1. Spyderbat Ingest (Cloudflare → Spyderbat) ──────────────────────────
SPYDERBAT_API_URL=https://api.spyderbat.com
SPYDERBAT_API_TOKEN=your-spyderbat-api-token-here
SPYDERBAT_ORG_UID=your-spyderbat-org-uid-here

# ── 2. Logpush Webhook Auth ───────────────────────────────────────────────
# Shared secret between this Worker and the Cloudflare Logpush job.
# Used in the X-Auth-Secret request header.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# ── 3. Cloudflare API (Reverse Block: Spyderbat → Cloudflare) ────────────
CF_API_TOKEN=your-cloudflare-api-token-here
CF_ACCOUNT_ID=your-cloudflare-account-id-here
CF_ZONE_ID=your-cloudflare-zone-id-here
CF_IP_LIST_ID=your-spyderbat-blocklist-ip-list-id-here

# ── 4. Spyderbat → Worker Webhook Auth ───────────────────────────────────
# HMAC-SHA256 secret. Configured in Spyderbat Policies → Response Actions → Webhook.
SPYDERBAT_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# ── 5. AI Gateway (Shadow AI Detection) ──────────────────────────────────
# The gateway name you created in Cloudflare AI → AI Gateway.
CF_AI_GATEWAY_ID=corporate-ai-gateway

# ── 6. AI Governance Admin ───────────────────────────────────────────────
# Controls access to /gov/stats, /gov/audit, /gov/whitelist, /gov/unblock.
# MUST be different from AUTH_SECRET and SPYDERBAT_WEBHOOK_SECRET.
GOV_ADMIN_SECRET=generate-with-openssl-rand-hex-32
