# ── Local development only (.env.example) ─────────────────────────────────
# Copy this to .dev.vars for `wrangler dev` local overrides.
# NEVER commit .dev.vars or any file with real values.
#
# In production, set these as Wrangler secrets:
#   wrangler secret put SPYDERBAT_API_URL
#   wrangler secret put SPYDERBAT_API_TOKEN
#   wrangler secret put SPYDERBAT_ORG_UID
#   wrangler secret put AUTH_SECRET

SPYDERBAT_API_URL=https://api.spyderbat.com
SPYDERBAT_API_TOKEN=your-spyderbat-api-token-here
SPYDERBAT_ORG_UID=your-spyderbat-org-uid-here
AUTH_SECRET=generate-a-random-32-char-secret-here
